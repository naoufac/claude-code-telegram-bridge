# --- required ---------------------------------------------------------------
# Bot token from @BotFather
TG_TOKEN=123456789:AA...your-token...
# Your numeric Telegram user id (message @userinfobot to find it).
# The bridge answers ONLY this user.
OWNER_ID=12345678

# --- optional ---------------------------------------------------------------
# Path to the claude binary (default: ~/.local/bin/claude)
#CLAUDE_BIN=/root/.local/bin/claude
# Working directory for claude turns (default: $HOME)
#CLAUDE_WORKDIR=/root
# Hard per-turn time limit in seconds (default 3600)
#RUN_TIMEOUT=3600
# Shown in /start and on the dashboard
#BRIDGE_LABEL=my-vps (203.0.113.7)
# Where Telegram uploads are saved (default: ~/tg-uploads)
#UPLOAD_DIR=/root/tg-uploads

# --- voice transcription (optional, tried in this order) --------------------
#ELEVENLABS_API_KEY=
#GEMINI_API_KEY=

# --- web dashboard (optional; off unless both are set) ----------------------
#DASH_PORT=8161
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
#DASH_KEY=
